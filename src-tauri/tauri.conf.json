{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RandomChoose",
  "version": "5.0.0",
  "identifier": "com.zhangxuan2011.random-choose",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RandomChoose",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/icon.icns"
    ]
  }
}
